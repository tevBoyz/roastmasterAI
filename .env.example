# Copy to .env and keep it private. Never put these values in public/ files.
PORT=3000
HOST=0.0.0.0
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Required whenever the AI service is enabled. Share the access code only with pilot users.
APP_ACCESS_CODE=replace-with-a-long-random-secret
# Limit each remote address to this many requests within 60 seconds (single Node instance only).
CHAT_REQUESTS_PER_MINUTE=10
